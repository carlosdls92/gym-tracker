# La URL real (con usuario/clave del usuario mongo "gym") vive en el servidor:
# /opt/github-runner/envs/gym-tracker.env  (el deploy la copia a .env)
# mongo corre con network_mode: host en omvdls → usar la IP LAN del host.
MONGODB_URL=mongodb://gym:<password>@192.168.0.23:27017/gym_tracker?authSource=gym_tracker
